# Database (Neon / Supabase / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/salesianos_cooperadores?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/salesianos_cooperadores?schema=public"

# Auth
AUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="salesianos-cooperadores"
S3_PUBLIC_URL="https://your-bucket.r2.cloudflarestorage.com"
# For R2, add this:
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
